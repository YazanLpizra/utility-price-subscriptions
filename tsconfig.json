{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // TypeScript has no "Bundler" value for `module` (only for `moduleResolution`);
    // ES2022 + Bundler resolution is the equivalent the plan intends.
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "worker-configuration.d.ts"]
}
