    "seed:dry": "node scripts/seed.mjs --dry-run",
    "smoke": "node scripts/smoke-quickstart.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@cloudflare/workers-types": "^5.20260906.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.129.0"
  }
}
