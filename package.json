{
  "name": "heating-oil-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply heating-oil --local",
    "dryrun": "wrangler deploy --dry-run --outdir=dist",
